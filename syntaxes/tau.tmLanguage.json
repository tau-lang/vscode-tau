{
  "scopeName": "text.tau",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#types"
    },
    {
      "include": "#entity"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constant"
    },
    {
      "include": "#variable"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tau",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape",
              "match": "\\\\[nt\"]"
            },
            {
              "name": "invalid",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([\\[\\];*A-Za-z0-9_ ]*)",
          "captures": {
            "1": {
              "name": "variable.other.tau"
            },
            "2": {
              "name": "punctuation.separator.type-annotation.tau"
            },
            "3": {
              "name": "entity.name.type.tau"
            }
          }
        },
        {
          "match": "(->|:)\\s*([\\[\\];*A-Za-z0-9_ ]*)",
          "captures": {
            "1": {
              "name": "punctuation.separator.type-annotation.tau"
            },
            "2": {
              "name": "entity.name.type.tau"
            }
          }
        }
      ]
    },
    "entity": {
      "patterns": [
        {
          "name": "meta.function.tau",
          "match": "\\b(?=fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "0": { "name": "keyword.control.tau" },
            "1": { "name": "entity.name.function.tau" }
          }
        },
        {
          "name": "meta.struct.tau",
          "match": "\\b(?=struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "0": { "name": "keyword.control.tau" },
            "1": { "name": "entity.name.type.tau" }
          }
        },
        {
          "name": "entity.name.function.tau",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tau",
          "match": "\\b(if|else|while|for|return|let|in|fn|struct)\\b"
        },
        {
          "name": "keyword.operator.tau",
          "match": "[=!<>]=|&&|\\|\\||[+*/%=<>!\\-&]"
        },
        {
          "name": "storage.modifier.tau",
          "match": "\\b(extern|const|io)\\b"
        }
      ]
    },
    "constant": {
      "patterns": [
        {
          "name": "constant.language.tau",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.tau",
          "match": "\\b[+-]?[0-9]+(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.other.tau",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "name": "variable.language.tau",
          "match": "\\b(self)\\b"
        },
        {
          "name": "variable.other.tau",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
