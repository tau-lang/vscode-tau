{
  "name": "tau-lang",
  "displayName": "Tau Syntax Highlighter",
  "description": "Syntax highlighting support for the experimental Tau language.",
  "version": "0.0.2",
  "publisher": "tau-lang",
  "repository": "https://codeberg.org/tau-lang/vscode-tau",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "images/icon.png",
  "contributes": {
    "languages": [
      {
        "id": "tau",
        "aliases": [
          "Tau",
          "tau"
        ],
        "extensions": [
          ".tau"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/tau-logo.png",
          "dark": "./images/tau-logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "tau",
        "scopeName": "text.tau",
        "path": "./syntaxes/tau.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tau",
        "path": "./snippets/tau.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "typescript": "^7.0.2"
  }
}